# 洞察后台前端 —— 生产 build 环境变量模板
# 复制为 insights-frontend/.env.production 后填好,再 `npm run build`。
# ⚠️ Vite 把这些值【静态内联进 bundle】,改了必须重新 build dist 才生效。
# 三个都必须填,缺任一会回退 localhost(生产必崩)。

# 洞察后端地址(本服务自己的 API)—— admin/agent 都打这里
VITE_INSIGHTS_BASE=https://insights.shuangdayeye.cn

# 主平台 backend 地址(insights 前端跨域调 BYOK 订单审核等用)
VITE_PLATFORM_BASE=https://api.shuangdayeye.cn

# 管理 token —— 必须与服务器 .env 的 INSIGHTS_ADMIN_TOKEN 同值(三处同值)。
# 用 `openssl rand -hex 24` 生成一把,三处(本文件 / 服务器 .env / 主 backend .env)都填它。
# 注:它会进 bundle,但整站 nginx Basic Auth 已挡住外网下载 bundle,故可接受。
VITE_ADMIN_TOKEN=
