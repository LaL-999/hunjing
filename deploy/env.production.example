# 浑晶生产环境变量 —— 复制到 /opt/huimeng/app/.env 后填好(切勿入库!)
# config.py 会自动从【项目根 .env】加载,所以放在 /opt/huimeng/app/.env。

# ============ 必填 ============
# JWT 签名密钥 —— 用 `openssl rand -hex 32` 生成一个强随机串,绝不能用 dev 默认值
HUIMENG_JWT_SECRET=

# ============ 路径(绝对路径,避免 CWD 歧义)============
HUIMENG_DB_PATH=/opt/huimeng/app/backend/data/huimeng.db
HUIMENG_UPLOADS_DIR=/opt/huimeng/app/backend/data/uploads

# ============ CORS(生产域名 + 桌面端 tauri origin 走 main.py regex)============
HUIMENG_CORS_ORIGINS=https://shuangdayeye.cn,https://www.shuangdayeye.cn,https://app.shuangdayeye.cn

# ============ LLM(DeepSeek 主路由)============
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ============ 邮箱 OTP(注册/登录发验证码必需,不配用户登录不了)============
HUIMENG_SMTP_HOST=smtp.qq.com
HUIMENG_SMTP_PORT=465
HUIMENG_SMTP_USER=
HUIMENG_SMTP_PASS=
HUIMENG_SMTP_FROM=

# ============ 收款(统一支付复用 BYOK 收款配置)============
BYOK_PAYEE_NAME=
# 收款码图片放 /opt/huimeng/app/backend/data/payment_qrcodes/ 下,这里填文件名
BYOK_WECHAT_QR_FILENAME=

# ============ 可选:图像 / 视觉(漫创态 / 截图审核 Vision 用,不配则相关功能降级)============
HUIMENG_QWEN_API_KEY=
HUIMENG_JIMENG_API_KEY=

# ============ 可选:错误监控 ============
# VITE_SENTRY_DSN / SENTRY_DSN —— 见 docs/monitoring.md
