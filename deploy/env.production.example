# 浑晶生产环境变量 —— 复制到 /opt/huimeng/app/.env 后填好(切勿入库!chmod 600)
# config.py 会自动从【项目根 .env】加载,所以放在 /opt/huimeng/app/.env。
# 变量名必须带 HUIMENG_ 前缀(config.py 只认带前缀的);填错前缀会被静默忽略、回落默认值。

# ============ 必填 ============
# JWT 签名密钥 —— `openssl rand -hex 32` 生成,绝不能用 dev 默认值
HUIMENG_JWT_SECRET=

# 创始人登录邮箱(逗号分隔)—— 只有用这些邮箱注册的账号能审批支付订单!
# 不填则默认只认 javaspringcjiajia@foxmail.com,你用别的邮箱注册会一直 403 审不了单。
HUIMENG_FOUNDER_EMAILS=

# 运营后台 / 订单审核管理 token —— `openssl rand -hex 32` 生成。
# 不填会用源码里公开的弱默认 'huimeng-insights-dev-token'(= 任何人可批单/看支付凭证),必改!
INSIGHTS_ADMIN_TOKEN=

# ============ 路径(绝对路径,避免 CWD 歧义)============
HUIMENG_DB_PATH=/opt/huimeng/app/backend/data/huimeng.db
HUIMENG_UPLOADS_DIR=/opt/huimeng/app/backend/data/uploads

# ============ CORS(生产域名;桌面端 tauri origin 走 main.py regex 不用列)============
HUIMENG_CORS_ORIGINS=https://shuangdayeye.cn,https://www.shuangdayeye.cn,https://app.shuangdayeye.cn

# ============ LLM(DeepSeek 主路由)============
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ============ 邮箱 OTP(注册/登录发验证码必需,不配用户登录不了)============
HUIMENG_SMTP_HOST=smtp.qq.com
HUIMENG_SMTP_PORT=465
HUIMENG_SMTP_USER=
HUIMENG_SMTP_PASS=
HUIMENG_SMTP_FROM=

# ============ 收款(统一支付复用 BYOK 收款配置;变量名必须带 HUIMENG_BYOK_ 前缀)============
# ⚠️ 默认值是真名「李爽」,不填会把它公开 + 收款核对错。必填你自己的。
HUIMENG_BYOK_PAYEE_NAME=
# 收款码图片放 /opt/huimeng/app/backend/data/payment_qrcodes/ 下,这里填文件名
HUIMENG_BYOK_WECHAT_QR_FILENAME=
# 支付宝收款码(可选)
HUIMENG_BYOK_ALIPAY_QR_FILENAME=
# 有新订单待审时通知到哪个邮箱(填你常看的)
HUIMENG_BYOK_REVIEW_NOTIFY_EMAIL=

# ============ 可选:图像 / 视觉(漫创态 / 截图审核 Vision 用,不配则相关功能降级)============
HUIMENG_QWEN_API_KEY=
HUIMENG_JIMENG_API_KEY=

# ============ 说明 ============
# 后端监听地址/端口由 systemd unit 的 ExecStart 决定(--host 127.0.0.1 --port 8000),
# 改本文件里的 HOST/PORT 无效(nginx 反代到 127.0.0.1:8000,这样最安全)。
# 错误监控 Sentry DSN 见 docs/monitoring.md。
