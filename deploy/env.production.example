# 浑晶生产环境变量 —— 复制到 /opt/huimeng/app/.env 后填好(切勿入库!chmod 600)
# config.py 会自动从【项目根 .env】加载,所以放在 /opt/huimeng/app/.env。
# 变量名必须带 HUIMENG_ 前缀(config.py 只认带前缀的);填错前缀会被静默忽略、回落默认值。

# ============ 必填 ============
# JWT 签名密钥 —— `openssl rand -hex 32` 生成,绝不能用 dev 默认值
HUIMENG_JWT_SECRET=

# 创始人登录邮箱(逗号分隔)—— 只有用这些邮箱注册的账号能审批支付订单!
# 不填则默认只认 javaspringcjiajia@foxmail.com,你用别的邮箱注册会一直 403 审不了单。
HUIMENG_FOUNDER_EMAILS=

# 运营后台 / 订单审核管理 token —— `openssl rand -hex 24` 生成。
# 不填会用源码里公开的弱默认 'huimeng-insights-dev-token'(= 任何人可批单/看支付凭证),必改!
# ⚠️ 部署洞察后台(insights)后,这把 token 同时门禁洞察 admin/agent 接口,且必须与
#    insights-frontend build 时注入的 VITE_ADMIN_TOKEN 同值(三处同值,见 INSIGHTS_DEPLOY.md)。
INSIGHTS_ADMIN_TOKEN=

# ============ 路径(绝对路径,避免 CWD 歧义)============
HUIMENG_DB_PATH=/opt/huimeng/app/backend/data/huimeng.db
HUIMENG_UPLOADS_DIR=/opt/huimeng/app/backend/data/uploads

# ============ CORS(生产域名;桌面端 tauri origin 走 main.py regex 不用列)============
# 部署洞察后台后,insights 子域要加进来(insights 前端跨域调主 backend 的 BYOK 审核接口)
HUIMENG_CORS_ORIGINS=https://shuangdayeye.cn,https://www.shuangdayeye.cn,https://app.shuangdayeye.cn,https://insights.shuangdayeye.cn

# ============ LLM(DeepSeek 主路由)============
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ============ 邮箱 OTP(注册/登录发验证码必需,不配用户登录不了)============
HUIMENG_SMTP_HOST=smtp.qq.com
HUIMENG_SMTP_PORT=465
HUIMENG_SMTP_USER=
HUIMENG_SMTP_PASS=
HUIMENG_SMTP_FROM=

# ============ 收款(统一支付复用 BYOK 收款配置;变量名必须带 HUIMENG_BYOK_ 前缀)============
# PAYEE_NAME:收款账户的**真实姓名**,只用于 Vision LLM 比对付款截图里的"收款方"(防伪),
#   不展示给任何用户。换收款账户时填新账户真实姓名(可脱敏,如「张*三」),否则自动核对会失败
#   → 订单落到人工审核。默认值仍是旧真名,务必覆盖。
HUIMENG_BYOK_PAYEE_NAME=
# PAYEE_DISPLAY_NAME:**展示给用户**的收款方名称(支付指引/弹窗里"向【X】转账")。
#   与真实姓名解耦,对外只露品牌名。不填默认「Ever」。
HUIMENG_BYOK_PAYEE_DISPLAY_NAME=Ever
# 收款码图片放 /opt/huimeng/app/backend/data/payment_qrcodes/ 下,这里填文件名
HUIMENG_BYOK_WECHAT_QR_FILENAME=
# 支付宝收款码(可选)
HUIMENG_BYOK_ALIPAY_QR_FILENAME=
# 有新订单待审时通知到哪个邮箱(填你常看的)
HUIMENG_BYOK_REVIEW_NOTIFY_EMAIL=

# ============ 可选:图像 / 视觉(漫创态 / 截图审核 Vision 用,不配则相关功能降级)============
HUIMENG_QWEN_API_KEY=
HUIMENG_JIMENG_API_KEY=

# ============ 洞察后台 insights(部署 insights 子域后才需要;详见 INSIGHTS_DEPLOY.md)============
# 与主 backend 共用本文件(systemd huimeng-insights 也 EnvironmentFile 指向它)。
# INSIGHTS_ENV=production 由 systemd unit 注入,无需写这里。
#
# 主前端埋点来源 + insights 前端自身来源(逗号分隔;config.py 会叠加到内置 dev 白名单上)
INSIGHTS_ALLOWED_ORIGINS=https://app.shuangdayeye.cn,https://insights.shuangdayeye.cn
# 洞察 AI agent(每日总结)用的 LLM key —— 复用主平台 DeepSeek key 即可。
# 不填则 agent 总结功能降级(报错跳过),但所有数据看板正常工作。
INSIGHTS_LLM_API_KEY=
INSIGHTS_LLM_BASE_URL=https://api.deepseek.com/v1
INSIGHTS_LLM_MODEL=deepseek-chat

# ============ 说明 ============
# 后端监听地址/端口由 systemd unit 的 ExecStart 决定(--host 127.0.0.1 --port 8000),
# 改本文件里的 HOST/PORT 无效(nginx 反代到 127.0.0.1:8000,这样最安全)。
# 洞察后台同理:端口 8001 由 huimeng-insights.service 决定。
# 错误监控 Sentry DSN 见 docs/monitoring.md。
