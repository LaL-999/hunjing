# 浑晶项目根 .env 模板
# 实际 .env 文件位于**项目根目录**(与 simulate.py 共享同一份)
# 复制此模板内容到项目根 .env,填入实际值后即可启动 backend

# === LLM(已有,Sprint 1.D refine 服务用)===
# Sprint D.8 起 OPENAI_API_KEY / OPENAI_API_BASE / LLM_MODEL 是 DeepSeek 主路由的凭据,
#   也是文本路由 vendor='deepseek' 的实际 endpoint。新代码请通过 llm_routing 路由层访问。
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === Sprint D.8 — 多 vendor 路由层(详见 docs/ADR_D.8_国产API路由层.md) ===
# 三个 vendor 选择字段都有默认值,不填即用推荐配置;改这三个值后需重启后端
HUIMENG_TEXT_VENDOR=deepseek          # 文本:deepseek(默认)/ qwen / moonshot
HUIMENG_IMAGE_VENDOR=jimeng           # 绘图:jimeng(默认)/ wanx / kolors — D.9 漫画态用
HUIMENG_VISION_VENDOR=qwen_vl         # 视觉:qwen_vl(默认)/ glm_4v — D.9 质检 agent 用

# 阿里灵积(DashScope)统一 key — 同时给视觉 / Qwen-Max(文本备份)用
# 开通:https://dashscope.console.aliyun.com/apiKey
HUIMENG_QWEN_API_KEY=
# 视觉模型 ID — 控制台模型库精确字符串(默认 qwen-vl-max-latest;新模型出来改这里就够)
HUIMENG_QWEN_VL_MODEL=qwen-vl-max-latest

# 图像生成 vendor — adapter 按 api_base 域名自动探测,改 3 个字段切 vendor:
#
# 选项 A:字节火山方舟 Doubao Seedream(2K+ 画质,¥0.20-0.30 / 张,中等成本)
#   开通:https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
#   注:这里要 sk-xxx 形式的 ARK API_KEY,不是 IAM 的 AK/SK 对
#   HUIMENG_JIMENG_API_BASE=https://ark.cn-beijing.volces.com/api/v3
#   HUIMENG_JIMENG_MODEL=doubao-seedream-5-0-260128
#
# 选项 B:SiliconFlow 开源模型(免费档 ¥14 试用 / 付费档 Qwen-Image ~¥0.07 / 张)
#   开通:https://cloud.siliconflow.cn/account/ak
#   ⚠️ Qwen-Image 是付费模型(试用额度耗尽返 403 30001),免费可改 Kwai-Kolors/Kolors
#   HUIMENG_JIMENG_API_BASE=https://api.siliconflow.cn/v1
#   HUIMENG_JIMENG_MODEL=Kwai-Kolors/Kolors           # 免费档(推荐先试用)
#   HUIMENG_JIMENG_MODEL=Qwen/Qwen-Image              # 付费档(需控制台开通授权)
#
# 选项 C:智谱 BigModel CogView-4(Sprint 5.10++ 加入,¥0.5 / 张标准画质,中文 prompt 友好)
#   开通:https://www.bigmodel.cn/usercenter/apikeys
#   注:智谱 OpenAI 兼容 endpoint,无需 zai SDK
#   HUIMENG_JIMENG_API_BASE=https://open.bigmodel.cn/api/paas/v4
#   HUIMENG_JIMENG_MODEL=cogview-4-250304            # 最新版,¥0.5 / 张
#   HUIMENG_JIMENG_MODEL=cogview-3-plus              # 经济版,¥0.06 / 张
#
# 选定一组后填下面 3 行(默认是火山方舟 ARK):
HUIMENG_JIMENG_API_KEY=
HUIMENG_JIMENG_MODEL=doubao-seedream-5-0-260128
HUIMENG_JIMENG_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# === 数据库 ===
HUIMENG_DB_PATH=backend/data/huimeng.db

# === JWT(必填,用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成)===
HUIMENG_JWT_SECRET=
HUIMENG_JWT_TTL_SECONDS=604800

# === OTP 邮箱(QQ 邮箱推荐) ===
# 开通授权码:QQ 邮箱设置 → 账号 → POP3/IMAP/SMTP 服务 → 开启 → 生成授权码
HUIMENG_SMTP_HOST=smtp.qq.com
HUIMENG_SMTP_PORT=465
HUIMENG_SMTP_USER=          # 你的 QQ 邮箱地址,如 yourname@qq.com
HUIMENG_SMTP_PASS=          # QQ 邮箱授权码(不是登录密码!16 位字母)
HUIMENG_SMTP_FROM=          # 通常等于 HUIMENG_SMTP_USER

# === 服务器 ===
HUIMENG_API_HOST=0.0.0.0
HUIMENG_API_PORT=8000
# CORS 放行的前端来源(逗号分隔)。本地 dev 用 localhost;
# 生产把门户 + app 子域加上(桌面端 tauri:// 走 main.py 的 regex,不用列这里)。
# 例:HUIMENG_CORS_ORIGINS=https://shuangdayeye.cn,https://www.shuangdayeye.cn,https://app.shuangdayeye.cn
HUIMENG_CORS_ORIGINS=http://localhost:5173

# === 上线监控:Sentry(2026-06-02 加)===
# 注册 https://sentry.io 拿 DSN(免费档够用 5000 条事件 / 月)
# 详细教程:docs/sentry_setup.md
# 本地开发不填 → 跳过初始化,不影响.
# 生产填上 → backend 自动捕获 5xx + WARNING/ERROR log + 慢请求
SENTRY_DSN=
ENV=production
